NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for Team management (invite/reset/remove accounts).
# Find it under Supabase Dashboard -> Project Settings -> API (service_role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only. Required to email login credentials on invite.
# Get a key at https://resend.com/api-keys. RESEND_FROM must be an
# onboarding address (onboarding@resend.dev) for testing or a verified
# domain address for production.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Karna Technical <onboarding@resend.dev>
