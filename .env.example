NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for Team management (invite/reset/remove accounts).
# Find it under Supabase Dashboard -> Project Settings -> API (service_role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public. Used to build absolute Team invitation links (/auth/confirm).
# Local: http://localhost:3000 — Production: your Vercel URL (e.g. https://karna-website.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Required to email Team invitations on invite.
# Get a key at https://resend.com/api-keys. RESEND_FROM must be an
# onboarding address (onboarding@resend.dev) for testing — test mail only
# reaches your own inbox — or a verified domain address for production.
# To verify: Resend → Domains → add karnaengservice.com → add the SPF/DKIM
# records in Squarespace (Domains → domain → DNS → DNS Settings → Custom
# Records) → verify in Resend → set e.g. Karna Technical <team@karnaengservice.com>.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Karna Technical <noreply@mail.karnaengservice.com>
# Replies to invite/reset mail land in the business mailbox.
RESEND_REPLY_TO=karnatech@karnaengservice.com
